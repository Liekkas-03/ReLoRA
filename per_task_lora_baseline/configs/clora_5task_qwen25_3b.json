{
  "run_name": "clora5_qwen25_3b",
  "base_model_name_or_path": "Qwen/Qwen2.5-3B-Instruct",
  "output_root": "outputs/per_task_lora",
  "dataset_cache_dir": null,
  "model_cache_dir": null,
  "seed": 42,
  "tasks": ["agnews", "amazon", "yelp", "dbpedia", "yahoo"],
  "data": {
